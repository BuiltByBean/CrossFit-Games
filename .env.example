# Railway Postgres connection string.
#
# Railway → your Postgres service → Variables → DATABASE_URL.
# Use the public URL when seeding from your laptop, and the internal
# (postgres.railway.internal) URL for the deployed app.
#
# Leave this unset and the site reads data/analysis.json instead, which is
# committed — so it runs fine with no database at all.
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:PORT/railway"
